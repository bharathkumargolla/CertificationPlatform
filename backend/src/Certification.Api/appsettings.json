{
  "Application": {
    "Name": "Certification Assessment Platform",
    "Url": "https://localhost:5001",
    "SupportEmail": "support@example.com"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "MaxRetryCount": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "CertificationPlatform",
    "Audience": "CertificationPlatform.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=certification;Username=postgres;Password=CHANGE_ME"
  },
  "AllowedHosts": "*"
}
